# Server Configuration
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Supabase Configuration
SUPABASE_URL=https://your-server.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CSRF Protection (required)
CSRF_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal API key (shared secret between Next.js proxy and this backend)
INTERNAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-server.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_API_VERSION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Development Tools (optional)
ANALYZE=false

# Google Search
GOOGLE_SEARCH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SEARCH_CX=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Bedrock Model Configuration (env-configurable with fallbacks)
BEDROCK_DEFAULT_MODEL=
BEDROCK_GROUNDING_MODEL=
BEDROCK_AVAILABLE_MODELS=

# PostHog Analytics
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com