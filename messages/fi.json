  "faq": {
    "title": "Usein kysytyt kysymykset",
    "subtitle": "Kaikki mitä sinun tarvitsee tietää ennen aloittamista",
    "items": {
      "whatIsCoasty": {
        "question": "Mikä on Coasty?",
        "answer": "Coasty on maailman paras computer-use AI-agentti. Kuvailet tehtävän — tutki liidejä, testaa verkkosivusto, täytä lomakkeita, julkaise sosiaalisessa mediassa — ja Coasty avaa oikean selaimen, navigoi sovelluksissa, napsauttaa painikkeita, kirjoittaa tekstiä ja suorittaa tehtävän alusta loppuun. Ei API:ta, ei integraatioita, ei koodia."
      },
      "howDifferent": {
        "question": "Miten tämä eroaa ChatGPT:stä tai muista AI-työkaluista?",
        "answer": "ChatGPT tuottaa tekstiä. Coasty käyttää tietokonetta. Se ei kerro mitä tehdä — se avaa selaimen, navigoi verkkosivustolle, napsauttaa painikkeita, täyttää lomakkeet ja toimittaa valmiin työn. Se on ero ohjeiden saamisen ja tehtävän tekemisen välillä puolestasi."
      },
      "whatTasks": {
        "question": "Mitä tehtäviä Coasty voi automatisoida?",
        "answer": "Minkä tahansa tehtävän jonka voit tehdä tietokoneella. Verkkotutka, liidien generointi, tietojen syöttö, lomakkeiden täyttö, QA-testaus, sosiaalisen median julkaisut, sähköposti-outreach, laskujen käsittely, kilpailija-analyysi, rekrytointi — jos se sisältää selaimen tai työpöytäsovelluksen, Coasty osaa tehdä sen."
      },
      "whatAreCredits": {
        "question": "Mitä ovat krediitit ja miten niitä käytetään?",
        "answer": "Krediittejä kulutetaan kun agentti työskentelee tehtävien parissa. Pidemmät, monimutkaisemmat tehtävät käyttävät enemmän krediittejä. Maksulliset paketit sisältävät kuukausittaisia krediittejä, ja voit myös ostaa lisäkrediittipaketteja milloin tahansa."
      },
      "localComputer": {
        "question": "Voiko Coasty toimia omalla tietokoneellani?",
        "answer": "Kyllä. Työpöytäsovelluksemme toimii kevyenä overlay-kerroksena koneellasi, ohjaten paikallista selaintasi ja sovelluksiasi suoraan. Vaihtoehtoisesti tehtävät suoritetaan eristetyillä pilvikoneillla — sinun valintasi."
      },
      "dataSafe": {
        "question": "Onko tietoni turvassa?",
        "answer": "Jokainen tehtävä suoritetaan eristetyssä sandbox-ympäristössä. Mikään ei vuoda istuntojen välillä. Tunnistetietosi pysyvät yksityisinä, ja jokainen toiminto kirjataan kuvakaappauksin kattavaan tarkastusjälkeen, jota voit tarkastella milloin tahansa."
      }
    }
  },
